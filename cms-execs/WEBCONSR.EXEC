/* WEBCONSRV EXEC - CMS web console HTTP/1.0 server (M0/M1 skeleton).   */
/* Plain HTTP, no SSL. RXSOCKET on CMS. Read-only allowlist by default.  */
/*                                                                        */
/* Usage: WEBCONSRV [configfn configft configfm]                          */
/* Default config: WEBCON CFG A                                           */
/*                                                                        */
/* Exit: 0 normal stop, 20 socket/config failure.                         */
parse arg cfn cft cfm .
if translate(cfn) = 'HASH' then do
  say pass_hash(cft)
  exit 0
end
say 'WEBCONSR: start'
if cfn = '' then cfn = 'WEBCON'
if cft = '' then cft = 'CFG'
if cfm = '' then cfm = 'A'
call cfg_load cfn cft cfm
call audit 'START' 'port=' cfg.port
say 'WEBCONSR: audit ok'
parse value socket('Initialize','WEBCONS') with rc .
if rc \= 0 then call die 'Initialize' rc
parse value socket('Socket') with rc lsid .
if rc \= 0 then call die 'Socket' rc
parse value socket('Bind', lsid, 'AF_INET' cfg.port 'INADDR_ANY'),
  with rc .
if rc \= 0 then call die 'Bind' rc
parse value socket('Listen', lsid, 5) with rc .
if rc \= 0 then call die 'Listen' rc
say 'WEBCONSR: listening on port' cfg.port
signal on syntax name err_h

do forever
  parse value socket('Accept', lsid) with rc cs .
  if rc \= 0 then do
    call audit 'ACCEPTERR' rc
    iterate
  end
  call handle cs
  call socket 'Close', cs
end
/* not reached */
call socket 'Close', lsid
call socket 'Terminate'
exit 0

err_h:
  zline = sourceline(sigl)
  zmsg = 'ERR' rc 'LINE' sigl ':' zline 'EVN=' evn 'K=' known.0
  'EXECIO 1 DISKW WEBCON ERR A (STRING' zmsg
  exit 20

die: procedure expose cfg.
  parse arg what rc
  say 'WEBCONSRV: fail' what 'rc=' rc
  call socket 'Terminate'
  exit 20

/* Handle one HTTP connection. */
handle: procedure expose cfg. sess. ev. evn known. ev_init
  parse arg cs
  req = http_read(cs)
  if req = '' then return
  p = pos('0D25'x||'0D25'x, req)
  if p = 0 then return
  hdrs = left(req, p - 1)
  body = substr(req, p + 4)
  parse var hdrs rline '0D25'x rest
  parse var rline method path ver
  method = strip(method)
  path = strip(path)
  call audit 'REQ' method path
  if method = 'GET' & path = '/' then do
    call serve_file cs, cfg.uifile, 'text/html; charset=us-ascii'
    return
  end
  if method = 'GET' & path = '/api/status' then do
    call serve_json cs, 200, '{"ok":true,"userid":"'userid()'"}'
    return
  end
  tok = cookie_tok(hdrs)
  if method = 'GET' & path = '/api/perf' then do
    call api_perf cs, tok
    return
  end
  if method = 'GET' & path = '/api/log' then do
    call api_syslog cs, tok
    return
  end
  if method = 'GET' & path = '/api/top' then do
    call api_top cs, tok
    return
  end
  if method = 'GET' & path = '/api/spool' then do
    call api_spool cs, tok
    return
  end
  if method \= 'POST' then do
    call serve_json cs, 405, '{"ok":false,"error":"method not allowed"}'
    return
  end
  select
    when path = '/api/login'  then call api_login cs, body
    when path = '/api/logout' then call api_logout cs, tok
    when path = '/api/cmd'    then call api_cmd cs, tok, body, hdrs
    when path = '/api/spool/purge' then,
      call api_spool_purge cs, tok, body, hdrs
    when path = '/api/spool/read' then,
      call api_spool_read cs, tok, body, hdrs
    otherwise call serve_json cs, 404, '{"ok":false,"error":"not found"}'
  end
  return

/* Read HTTP request from socket; return EBCDIC text. */
http_read: procedure expose cfg.
  parse arg cs
  req = ''
  hdrend = 0
  need = 0
  do 40
    r = socket('Recv', cs, 2000)
    parse var r rc n .
    if rc \= 0 then leave
    if \datatype(n,'W') then leave
    if n = 0 then leave
    raw = right(r, n)
    t = socket('Translate', raw, 'To_Ebcdic')
    parse var t trc tlen .
    if trc \= 0 then leave
    req = req || right(t, tlen)
    if hdrend = 0 then do
      p = pos('0D25'x||'0D25'x, req)
      if p > 0 then do
        hdrend = p + 4
        need = hdrend - 1 + content_length(left(req, p - 1))
      end
    end
    if hdrend > 0 & length(req) >= need then leave
    if length(req) > cfg.max_body + 4096 then leave
  end
  return req

content_length: procedure
  parse arg hdrs
  cl = 0
  do while hdrs \= ''
    parse var hdrs line '0D25'x hdrs
    if left(translate(strip(line)), 15) = 'CONTENT-LENGTH:' then
      cl = strip(substr(line, 16))
  end
  if datatype(cl, 'W') then return cl
  return 0

/* Send an HTTP response. body is EBCDIC text. */
send_resp: procedure
  parse arg cs, status, reason, ctype, body, extra
  if extra = '' then extra = ''
  resp = 'HTTP/1.0' status reason || '0D25'x ||,
         'Content-Type:' ctype || '0D25'x ||,
         'Connection: close' || '0D25'x ||,
         'X-Content-Type-Options: nosniff' || '0D25'x ||,
         extra ||,
         '0D25'x || body
  ta = socket('Translate', resp, 'To_Ascii')
  parse var ta arc alen .
  if arc \= 0 then return
  sr = socket('Send', cs, right(ta, alen))
  return

serve_json: procedure
  parse arg cs, status, json, extra
  reason = 'OK'
  if status = 400 then reason = 'Bad Request'
  if status = 401 then reason = 'Unauthorized'
  if status = 403 then reason = 'Forbidden'
  if status = 404 then reason = 'Not Found'
  if status = 405 then reason = 'Method Not Allowed'
  if status = 413 then reason = 'Payload Too Large'
  if status = 500 then reason = 'Internal Server Error'
  call send_resp cs, status, reason, 'application/json', json, extra
  return

/* Serve a CMS file as static content. */
serve_file: procedure
  parse arg cs, fid, ctype
  parse var fid fn ft fm .
  if fn = '' | ft = '' | fm = '' then do
    call serve_json cs, 500, '{"ok":false,"error":"bad file id"}'
    return
  end
  body = ''
  'EXECIO * DISKR' fn ft fm '(FINIS STEM L.'
  if rc \= 0 then do
    call serve_json cs, 404, '{"ok":false,"error":"ui not found"}'
    return
  end
  do i = 1 to L.0
    body = body || strip(L.i, 'T') || '0D25'x
  end
  call send_resp cs, 200, 'OK', ctype, body, ''
  return

hdr_val: procedure
  parse arg hdrs, name
  want = translate(strip(name)) || ':'
  do while hdrs \= ''
    parse var hdrs line '0D25'x hdrs
    ul = translate(strip(line))
    if abbrev(ul, want) then return strip(substr(strip(line), length(want) + 1))
  end
  return ''

cookie_tok: procedure
  parse arg hdrs
  tok = ''
  do while hdrs \= ''
    parse var hdrs line '0D25'x hdrs
    if left(translate(strip(line)), 7) = 'COOKIE:' then do
      c = substr(line, 8)
      p = pos('webcons=', c)
      if p > 0 then do
        tok = substr(c, p + 8)
        sv = verify(tok, '0123456789abcdefABCDEF', 'N')
        if sv > 0 then tok = left(tok, sv - 1)
        else tok = strip(tok)
      end
    end
  end
  return tok

sess_new: procedure expose sess. cfg.
  tok = ''
  ctok = ''
  do i = 1 to 4
    tok = tok || d2x(random(0,65535),4) || d2x(random(0,65535),4)
    ctok = ctok || d2x(random(0,65535),4) || d2x(random(0,65535),4)
  end
  tok = translate(tok)
  ctok = translate(ctok)
  sess.tok = '1'
  sess.exp.tok = time('S') + cfg.session_ttl
  sess.csrf.tok = ctok
  return tok ctok

sess_ok: procedure expose sess. cfg.
  parse arg tok
  if tok = '' then return 0
  if sess.tok \== '1' then return 0
  if time('S') > sess.exp.tok then return 0
  sess.exp.tok = time('S') + cfg.session_ttl
  return 1

sess_csrf: procedure expose sess.
  parse arg tok
  if tok = '' then return ''
  return sess.csrf.tok

sess_del: procedure expose sess.
  parse arg tok
  if tok = '' then return
  sess.tok = '0'
  return

api_login: procedure expose cfg. sess.
  parse arg cs, body
  if cfg.noauth then do
    parse value sess_new() with tok ctok
    extra = 'Set-Cookie: webcons=' || tok ||,
            '; HttpOnly; SameSite=Strict' || '0D25'x
    call serve_json cs, 200, '{"ok":true,"csrf":"'ctok'"}', extra
    return
  end
  if cfg.lock_until > 0 & time('S') < cfg.lock_until then do
    call audit 'AUTHLOCK' ''
    call serve_json cs, 403, '{"ok":false,"error":"locked out"}'
    return
  end
  u = json_str(body, 'user')
  pw = json_str(body, 'pass')
  ok = 0
  if u = cfg.userid then ok = pass_ok(pw)
  if \ok then do
    cfg.fail_n = cfg.fail_n + 1
    if cfg.fail_n >= cfg.max_fail then do
      cfg.lock_until = time('S') + cfg.lockout_sec
      call audit 'AUTHLOCK' u
    end
    call audit 'AUTHFAIL' u
    call serve_json cs, 401, '{"ok":false,"error":"bad credentials"}'
    return
  end
  cfg.fail_n = 0
  cfg.lock_until = 0
  cfg.audit_n = 0
  parse value sess_new() with tok ctok
  call audit 'AUTHOK' u
  extra = 'Set-Cookie: webcons=' || tok ||,
          '; HttpOnly; SameSite=Strict' || '0D25'x
  call serve_json cs, 200, '{"ok":true,"csrf":"'ctok'"}', extra
  return

pass_ok: procedure expose cfg.
  parse arg pw
  if cfg.passhash \= '' then
    return pass_hash(pw) = translate(strip(cfg.passhash))
  return pw = cfg.pass

pass_hash: procedure
  /* FNV-1a 32-bit over EBCDIC bytes; not cryptographic. */
  parse arg s
  numeric digits 20
  h = 2166136261
  do i = 1 to length(s)
    b = c2d(substr(s, i, 1))
    h = fnv_xor_byte(h, b)
    h = h * 16777619
    h = h // 4294967296
  end
  return 'FNV1A:' || d2x(h, 8)

fnv_xor_byte: procedure
  parse arg h, b
  numeric digits 20
  low = h // 256
  hi = h % 256
  r = 0; p = 1; a = low; bb = b
  do 8
    ba = a // 2; b2 = bb // 2
    if ba \== b2 then r = r + p
    a = a % 2; bb = bb % 2; p = p * 2
  end
  return hi * 256 + r

api_logout: procedure expose sess.
  parse arg cs, tok
  call sess_del tok
  extra = 'Set-Cookie: webcons=; Max-Age=0;' ||,
          ' HttpOnly; SameSite=Strict' || '0D25'x
  call serve_json cs, 200, '{"ok":true}', extra
  return

api_cmd: procedure expose cfg. sess.
  parse arg cs, tok, body, hdrs
  if \cfg.noauth then do
    if \sess_ok(tok) then do
      call serve_json cs, 401, '{"ok":false,"error":"not logged in"}'
      return
    end
    want = sess_csrf(tok)
    got = hdr_val(hdrs, 'X-CSRF-Token')
    if want = '' | translate(got) \= want then do
      call serve_json cs, 403, '{"ok":false,"error":"bad csrf"}'
      return
    end
  end
  cmd = json_str(body, 'cmd')
  cmd = strip(cmd)
  if cmd = '' then do
    call serve_json cs, 400, '{"ok":false,"error":"empty command"}'
    return
  end
  if length(cmd) > 200 then do
    call serve_json cs, 400, '{"ok":false,"error":"command too long"}'
    return
  end
  if pos('|',cmd)>0 | pos(';',cmd)>0 | pos('&',cmd)>0 |,
     pos('<',cmd)>0 | pos('>',cmd)>0 | pos('"',cmd)>0 |,
     pos("'",cmd)>0 | pos('60'x,cmd)>0 then do
    call audit 'DENYCHARS' cmd
    call serve_json cs, 403, '{"ok":false,"error":"bad characters"}'
    return
  end
  if \cmd_allowed(cmd) then do
    call audit 'DENY' cmd
    call serve_json cs, 403, '{"ok":false,"error":"command not allowed"}'
    return
  end
  call audit 'CMD' cmd
  parse value run_cmd(cmd) with rc '|' out
  out = json_esc(out)
  call serve_json cs, 200, '{"ok":true,"rc":'rc',"output":"'out'"}'
  return

/* Minimal JSON helpers. */
json_str: procedure
  parse arg body, key
  needle = '"' || key || '"'
  p = pos(needle, body)
  if p = 0 then return ''
  rest = substr(body, p + length(needle))
  p = pos(':', rest)
  if p = 0 then return ''
  rest = strip(substr(rest, p + 1), 'L')
  if left(rest, 1) \= '"' then return ''
  rest = substr(rest, 2)
  out = ''
  do while rest \= ''
    c = left(rest, 1)
    rest = substr(rest, 2)
    if c = '\' then do
      e = left(rest, 1); rest = substr(rest, 2)
      if e = 'n' then out = out || '0A'x
      else if e = 'r' then out = out || '0D'x
      else if e = 't' then out = out || '09'x
      else out = out || e
    end
    else if c = '"' then leave
    else out = out || c
  end
  return out

json_esc: procedure
  parse arg s
  out = ''
  do i = 1 to length(s)
    c = substr(s, i, 1)
    select
      when c = '\' then out = out || '\\'
      when c = '"' then out = out || '\"'
      when c = '0D'x then out = out || '\r'
      when c = '0A'x then out = out || '\n'
      when c = '09'x then out = out || '\t'
      otherwise out = out || c
    end
  end
  return out

cmd_allowed: procedure expose cfg.
  parse arg cmd
  ucmd = translate(strip(cmd))
  /* deny wins */
  do i = 1 to cfg.deny.0
    if glob_match(ucmd, translate(cfg.deny.i)) then return 0
  end
  do i = 1 to cfg.allow.0
    if glob_match(ucmd, translate(cfg.allow.i)) then return 1
  end
  return 0

glob_match: procedure
  parse arg text, pat
  if right(pat, 2) = ' *' then do
    pfx = left(pat, length(pat) - 2)
    if text = pfx then return 1
    return abbrev(text, pfx || ' ')
  end
  return text = pat

run_cmd: procedure expose cfg.
  parse arg cmd
  out = ''
  cmd = strip(cmd)
  parse var cmd verb rest
  verb = translate(verb)
  if rest = '' then cmd = verb
  else if verb = 'CP' then cmd = 'CP ' || translate(rest)
  else if verb = 'QUERY' | verb = 'INDICATE' |,
          verb = 'LISTFILE' | verb = 'TYPE' then,
    cmd = verb || ' ' || translate(rest)
  else cmd = verb rest
  ucmd = translate(cmd)
  pcmd = ''
  if abbrev(ucmd, 'CP ') then pcmd = 'PIPE CP' substr(cmd, 4)
  else if verb = 'TYPE' then pcmd = 'PIPE <' substr(cmd, 5)
  else if verb = 'INDICATE' then pcmd = 'PIPE CP' cmd
  if pcmd \= '' then do
    pcmd '| stem OUT.'
    crc = rc
    if symbol('OUT.0') = 'VAR' then n = OUT.0
    else n = 0
    do i = 1 to n
      line = OUT.i
      if length(out) + length(line) + 1 > cfg.max_out then do
        out = out || '[output capped]' || '0A'x
        leave
      end
      out = out || line || '0A'x
    end
    return crc || '|' || out
  end
  'MAKEBUF'
  buf = rc
  address command cmd '(STACK'
  crc = rc
  n = queued()
  do i = 1 to n
    parse pull line
    o.i = line
  end
  'DROPBUF' buf
  do i = n to 1 by -1
    if length(out) + length(o.i) + 1 > cfg.max_out then do
      out = out || '[output capped]' || '0A'x
      leave
    end
    out = out || o.i || '0A'x
  end
  if length(out) > cfg.max_out then
    out = left(out, cfg.max_out) || '[output capped]' || '0A'x
  return crc || '|' || out

cfg_load: procedure expose cfg.
  parse arg fn, ft, fm
  cfg.port = 8080
  cfg.bind = 'INADDR_ANY'
  cfg.userid = 'webuser'
  cfg.pass = 'changeme'
  cfg.passhash = ''
  cfg.session_ttl = 1800
  cfg.max_body = 4096
  cfg.max_out = 16384
  cfg.max_fail = 5
  cfg.lockout_sec = 300
  cfg.audit_max = 2000
  cfg.noauth = 0
  cfg.logfile = 'WEBCONS LOG A'
  cfg.uifile = 'WEBCONS HTML A'
  cfg.auditfile = 'WEBCONS AUDIT A'
  cfg.allow.0 = 0
  cfg.deny.0 = 0
  cfg.fail_n = 0
  cfg.lock_until = 0
  cfg.audit_n = 0
  'EXECIO * DISKR' fn ft fm '(FINIS STEM C.'
  if rc \= 0 then do
    say 'WEBCONSRV: config not found, using defaults'
    return
  end
  do i = 1 to C.0
    line = strip(C.i)
    if line = '' | left(line,1) = '*' then iterate
    parse var line key rest
    key = translate(strip(key))
    rest = strip(rest)
    select
      when key = 'PORT'        then cfg.port = rest
      when key = 'BIND'        then cfg.bind = rest
      when key = 'USERID'      then cfg.userid = rest
      when key = 'PASS'        then cfg.pass = rest
      when key = 'PASSHASH'    then cfg.passhash = rest
      when key = 'NOAUTH'      then cfg.noauth = rest
      when key = 'SESSION_TTL' then cfg.session_ttl = rest
      when key = 'MAX_BODY'    then cfg.max_body = rest
      when key = 'MAX_OUT'     then cfg.max_out = rest
      when key = 'MAX_FAIL'    then cfg.max_fail = rest
      when key = 'LOCKOUT_SEC' then cfg.lockout_sec = rest
      when key = 'AUDIT_MAX'   then cfg.audit_max = rest
      when key = 'LOGFILE'     then cfg.logfile = rest
      when key = 'UIFILE'      then cfg.uifile = rest
      when key = 'AUDITFILE'   then cfg.auditfile = rest
      when key = 'ALLOW'       then call cfg_add 'ALLOW', rest
      when key = 'DENY'        then call cfg_add 'DENY', rest
      otherwise nop
    end
  end
  return

cfg_add: procedure expose cfg.
  parse arg kind, val
  if kind = 'ALLOW' then do
    n = cfg.allow.0 + 1; cfg.allow.0 = n; cfg.allow.n = val
  end
  else do
    n = cfg.deny.0 + 1; cfg.deny.0 = n; cfg.deny.n = val
  end
  return

audit: procedure expose cfg.
  parse arg kind, msg
  parse var cfg.auditfile fn ft fm .
  if fn = '' then return
  cfg.audit_n = cfg.audit_n + 1
  if cfg.audit_max > 0 & cfg.audit_n >= cfg.audit_max then do
    'COPYFILE' fn ft fm fn 'AUDITOLD' fm '(REPLACE OLDDATE'
    'ERASE' fn ft fm
    cfg.audit_n = 0
  end
  line = date('S') time() userid() kind msg
  push line
  'EXECIO 1 DISKW' fn ft fm '(FINIS'
  if rc \= 0 then say 'WEBCONSRV: audit rc=' rc
  return


/* --- Performance dashboard --- */

api_top: procedure expose cfg. sess.
  parse arg cs, tok
  if \cfg.noauth & \sess_ok(tok) then do
    call serve_json cs, 401, '{"ok":false,"error":"not logged in"}'
    return
  end
  parse value run_cmd('CP QUERY NAMES') with rc '|' nout
  nu. = 0
  ucount = 0
  do while nout \= ''
    parse var nout line '0A'x nout
    line = translate(strip(line))
    do while line \= ''
      parse var line piece ',' line
      parse var piece uid '-' .
      uid = strip(uid)
      if uid = '' then iterate
      if words(uid) > 1 then iterate
      if nu.uid = 1 then iterate
      nu.uid = 1
      ucount = ucount + 1
      ulist.ucount = uid
    end
  end
  j = '{"ok":true,"users":['
  first = 1
  do i = 1 to ucount
    uid = ulist.i
    parse value run_cmd('CP INDICATE USER' uid) with irc '|' iout
    uj = top_parse(uid, iout)
    if uj = '' then iterate
    if \first then j = j || ','
    j = j || uj
    first = 0
  end
  j = j || ']}'
  call serve_json cs, 200, j
  return

top_parse: procedure
  parse arg uid, out
  vtime = ''; ttime = ''; ctime = ''
  io = 0; res = 0; ws = 0; inst = 0
  pread = 0; pwrite = 0
  do while out \= ''
    parse var out line '0A'x out
    u = translate(strip(line))
    if pos('CTIME=', u) > 0 then do
      parse var u . 'CTIME=' ct 'VTIME=' vt 'TTIME=' tt .
      ctime = strip(ct); vtime = strip(vt); ttime = strip(tt)
    end
    if pos('IO=', u) > 0 then do
      parse var u . 'IO=' iv .
      iv = strip(iv)
      if datatype(iv,'W') then io = iv + 0
    end
    if pos('PAGES:', u) > 0 then do
      parse var u . 'RES=' rv . 'WS=' wv .
      if datatype(strip(rv),'W') then res = strip(rv) + 0
      if datatype(strip(wv),'W') then ws = strip(wv) + 0
    end
    if pos('INSTAN=', u) > 0 then do
      parse var u . 'INSTAN=' iv2 .
      if datatype(strip(iv2),'W') then inst = strip(iv2) + 0
    end
    if pos('READS=', u) > 0 & pos('WRITES=', u) > 0 then do
      if pos('MDC', u) > 0 then iterate
      parse var u . 'READS=' pr . 'WRITES=' pw .
      if datatype(strip(pr),'W') then pread = strip(pr) + 0
      if datatype(strip(pw),'W') then pwrite = strip(pw) + 0
    end
  end
  if vtime = '' & ttime = '' & io = 0 then return ''
  uj = '{"id":"'json_esc(uid)'",'
  uj = uj || '"ctime":"'json_esc(ctime)'",'
  uj = uj || '"vtime":"'json_esc(vtime)'",'
  uj = uj || '"ttime":"'json_esc(ttime)'",'
  uj = uj || '"io":'io',"res":'res',"ws":'ws',"inst":'inst','
  uj = uj || '"pread":'pread',"pwrite":'pwrite'}'
  return uj

api_spool: procedure expose cfg. sess.
  parse arg cs, tok
  if \cfg.noauth & \sess_ok(tok) then do
    call serve_json cs, 401, '{"ok":false,"error":"not logged in"}'
    return
  end
  parse value run_cmd('CP QUERY RDR ALL') with rrc '|' rout
  parse value run_cmd('CP QUERY PRT ALL') with prc '|' pout
  j = '{"ok":true,"rdr":['
  j = j || spool_json(rout)
  j = j || '],"prt":['
  j = j || spool_json(pout)
  j = j || ']}'
  call serve_json cs, 200, j
  return

spool_json: procedure
  parse arg out
  j = ''
  first = 1
  do while out \= ''
    parse var out line '0A'x out
    line = strip(line)
    if line = '' then iterate
    u = translate(line)
    if abbrev(u, 'OWNERID') then iterate
    if abbrev(u, 'ORIGINID') then iterate
    if abbrev(u, 'NO ') then iterate
    if abbrev(u, 'READY') then iterate
    parse var line owner spoolid cls devtype recs cpy hold date time rest
    if \datatype(spoolid,'W') then iterate
    rest = strip(rest)
    fname = ''; ftype = ''; dist = ''
    if rest \= '' then parse var rest fname ftype dist
    if first then first = 0
    else j = j || ','
    j = j || '{"owner":"'json_esc(strip(owner))'",'
    j = j || '"id":"'json_esc(strip(spoolid))'",'
    j = j || '"class":"'json_esc(strip(cls))'",'
    j = j || '"type":"'json_esc(strip(devtype))'",'
    j = j || '"records":"'json_esc(strip(recs))'",'
    j = j || '"hold":"'json_esc(strip(hold))'",'
    j = j || '"date":"'json_esc(strip(date))'",'
    j = j || '"time":"'json_esc(strip(time))'",'
    j = j || '"name":"'json_esc(strip(fname))'",'
    j = j || '"ftype":"'json_esc(strip(ftype))'",'
    j = j || '"dist":"'json_esc(strip(dist))'"}'
  end
  return j

api_spool_purge: procedure expose cfg. sess.
  parse arg cs, tok, body, hdrs
  if \cfg.noauth then do
    if \sess_ok(tok) then do
      call serve_json cs, 401, '{"ok":false,"error":"not logged in"}'
      return
    end
    want = sess_csrf(tok)
    got = hdr_val(hdrs, 'X-CSRF-Token')
    if want = '' | translate(got) \= want then do
      call serve_json cs, 403, '{"ok":false,"error":"bad csrf"}'
      return
    end
  end
  typ = translate(strip(json_str(body, 'type')))
  all = translate(strip(json_str(body, 'all')))
  confirm = strip(json_str(body, 'confirm'))
  owner = translate(strip(json_str(body, 'owner')))
  sid = strip(json_str(body, 'id'))
  if all = 'TRUE' | all = '1' then do
    if confirm \= 'DELETE ALL' then do
      call serve_json cs, 400,,
        '{"ok":false,"error":"type DELETE ALL to confirm"}'
      return
    end
    call audit 'SPOOL' 'purge all' typ
    n = 0
    if typ = 'RDR' | typ = 'ALL' | typ = '' then do
      parse value run_cmd('CP PURGE * RDR ALL') with rc '|' out
      n = n + purge_count(out)
      call audit 'SPOOL' 'purge * rdr all rc='rc
    end
    if typ = 'PRT' | typ = 'ALL' | typ = '' then do
      parse value run_cmd('CP PURGE * PRT ALL') with rc '|' out
      n = n + purge_count(out)
      call audit 'SPOOL' 'purge * prt all rc='rc
    end
    call serve_json cs, 200, '{"ok":true,"purged":'n'}'
    return
  end
  if typ \= 'RDR' & typ \= 'PRT' then do
    call serve_json cs, 400, '{"ok":false,"error":"bad type"}'
    return
  end
  if \datatype(sid,'W') | owner = '' then do
    call serve_json cs, 400, '{"ok":false,"error":"need owner and id"}'
    return
  end
  call audit 'SPOOL' 'purge' owner typ sid
  parse value run_cmd('CP PURGE' owner typ sid) with rc '|' out
  n = purge_count(out)
  ok = 'true'
  if n = 0 then ok = 'false'
  call serve_json cs, 200, '{"ok":'ok',"rc":'rc',"purged":'n',',
    '"output":"'json_esc(strip(out))'"}'
  return

purge_count: procedure
  parse arg out
  n = 0
  do while out \= ''
    parse var out line '0A'x out
    u = translate(strip(line))
    if pos('NO FILES PURGED', u) > 0 then iterate
    if pos('FILE', u) > 0 & pos('PURGED', u) > 0 then do
      parse var u k 'FILE' .
      if datatype(strip(k),'W') then n = n + (strip(k) + 0)
      else n = n + 1
    end
  end
  return n

api_spool_read: procedure expose cfg. sess.
  parse arg cs, tok, body, hdrs
  if \cfg.noauth then do
    if \sess_ok(tok) then do
      call serve_json cs, 401, '{"ok":false,"error":"not logged in"}'
      return
    end
    want = sess_csrf(tok)
    got = hdr_val(hdrs, 'X-CSRF-Token')
    if want = '' | translate(got) \= want then do
      call serve_json cs, 403, '{"ok":false,"error":"bad csrf"}'
      return
    end
  end
  typ = translate(strip(json_str(body, 'type')))
  owner = translate(strip(json_str(body, 'owner')))
  sid = strip(json_str(body, 'id'))
  ocls = translate(strip(json_str(body, 'class')))
  ohold = translate(strip(json_str(body, 'hold')))
  oname = strip(json_str(body, 'name'))
  if typ \= 'RDR' & typ \= 'PRT' & typ \= 'PUN' then do
    call serve_json cs, 400, '{"ok":false,"error":"bad type"}'
    return
  end
  if \datatype(sid,'W') | owner = '' then do
    call serve_json cs, 400, '{"ok":false,"error":"need owner and id"}'
    return
  end
  if ocls = '' then ocls = 'A'
  if oname = '' then oname = 'SPOOLRD'
  oname = left(translate(strip(oname)), 8)
  call audit 'SPOOL' 'read' owner typ sid
  'ERASE SPOOLRD TMP A'
  parse value run_cmd('CP TRANSFER' owner typ sid 'WEBCONS RDR'),
    with rc '|' tout
  if rc \= 0 then do
    call serve_json cs, 200, '{"ok":false,"rc":'rc',',
      '"error":"'json_esc(strip(tout))'"}'
    return
  end
  parse value run_cmd('CP QUERY RDR WEBCONS ALL') with . '|' q1
  nid = sid; found = 0
  do while q1 \= ''
    parse var q1 ln '0A'x q1
    parse var ln . f .
    if datatype(strip(f),'W') then do
      nid = strip(f); found = 1
      if strip(f) = strip(sid) then leave
    end
  end
  if \found then do
    parse value run_cmd('CP QUERY RDR *') with . '|' q2
    do while q2 \= ''
      parse var q2 ln '0A'x q2
      parse var ln . f .
      if datatype(strip(f),'W') then nid = strip(f)
    end
  end
  'PIPE CMS RECEIVE' nid 'SPOOLRD TMP A (REPLACE OLDDATE | stem R.'
  rrc = rc
  rout = ''
  if symbol('R.0') = 'VAR' then do i=1 to R.0
    rout = rout || R.i || '0A'x
  end
  if rrc \= 0 then do
    'RECEIVE' nid 'SPOOLRD TMP A (REPLACE OLDDATE'
    rrc = rc
  end
  out = ''
  if rrc = 0 then do
    'EXECIO * DISKR SPOOLRD TMP A (FINIS STEM L.'
    if rc = 0 then do
      do i = 1 to L.0
        line = L.i
        if length(out) + length(line) + 1 > cfg.max_out then do
          out = out || '[output capped]' || '0A'x
          leave
        end
        out = out || line || '0A'x
      end
    end
  end
  /* restore: punch back directly to owner */
  restored = 0
  trc = 0
  if rrc = 0 then do
    'CP SPOOL PUNCH TO' owner 'CLASS' ocls 'NOHOLD'
    'PUNCH SPOOLRD TMP A (NOH'
    'CP CLOSE PUNCH NAME' oname
    trc = rc
    'CP SPOOL PUNCH OFF'
    if trc = 0 then do
      restored = 1
      parse value run_cmd('CP QUERY RDR' owner 'ALL') with . '|' qout
      newid = spool_last_id(qout)
      if newid \= '' then do
        'CP CHANGE * RDR' newid 'NAME' oname
        if ohold \= '' & ohold \= 'NONE' then
          'CP CHANGE * RDR' newid 'HOLD' ohold
        if typ \= 'RDR' then
          'CP TRANSFER * RDR' newid owner typ
      end
    end
  end
  else do
    'CP TRANSFER WEBCONS RDR' nid owner typ
    if rc = 0 then restored = 1
  end
  'ERASE SPOOLRD TMP A'
  rok = 'true'
  if rrc \= 0 then rok = 'false'
  note = 'spoolid may change on restore'
  if \restored then note = note '; restore rc='trc
  call serve_json cs, 200, '{"ok":'rok',"rc":'rrc',',
    '"output":"'json_esc(out)'","note":"'json_esc(note)'"}'
  return

spool_webrdr_id: procedure
  parse arg want
  parse value run_cmd('CP QUERY RDR WEBCONS ALL') with . '|' out
  id = want
  found = 0
  do while out \= ''
    parse var out line '0A'x out
    line = strip(line)
    if line = '' then iterate
    parse var line . f .
    if \datatype(strip(f),'W') then iterate
    id = strip(f)
    found = 1
    if strip(f) = strip(want) then return strip(f)
  end
  if found then return id
  parse value run_cmd('CP QUERY RDR *') with . '|' out2
  do while out2 \= ''
    parse var out2 line '0A'x out2
    line = strip(line)
    parse var line . f .
    if \datatype(strip(f),'W') then iterate
    id = strip(f)
  end
  return id

spool_last_id: procedure
  parse arg out
  id = ''
  do while out \= ''
    parse var out line '0A'x out
    line = strip(line)
    if line = '' then iterate
    parse var line . f .
    if \datatype(strip(f),'W') then iterate
    id = strip(f)
  end
  return id

spool_webrdr_last: procedure
  parse value run_cmd('CP QUERY RDR WEBCONS ALL') with . '|' out
  return spool_last_id(out)

api_syslog: procedure expose cfg. sess. ev. evn known. ev_init
  parse arg cs, tok
  if \cfg.noauth & \sess_ok(tok) then do
    call serve_json cs, 401, '{"ok":false,"error":"not logged in"}'
    return
  end
  parse value run_cmd('CP QUERY LOGMSG') with lrc '|' lout
  parse value run_cmd('CP QUERY NAMES') with nrc '|' nout
  now = time()
  nu. = 0
  ucount = 0
  do while nout \= ''
    parse var nout line '0A'x nout
    line = translate(strip(line))
    do while line \= ''
      parse var line piece ',' line
      parse var piece uid '-' .
      uid = strip(uid)
      if uid = '' then iterate
      if words(uid) > 1 then iterate
      if nu.uid = 1 then iterate
      nu.uid = 1
      ucount = ucount + 1
      ulist.ucount = uid
    end
  end
  if datatype(ev_init,'W') = 0 then ev_init = 0
  if datatype(evn,'W') = 0 then evn = 0
  if ev_init = 0 then ev_init = 1
  else do
    do i = 1 to ucount
      u = ulist.i
      if known.u = 1 then iterate
      call ev_add now, u 'logged on'
    end
    do i = 1 to known.0
      u = known.i
      if nu.u = 1 then iterate
      call ev_add now, u 'logged off'
    end
  end
  known. = 0
  known.0 = ucount
  do i = 1 to ucount
    u = ulist.i
    known.u = 1
    known.i = u
  end
  j = '{"ok":true,"users":'ucount',"logmsg":"'json_esc(strip(lout))'",'
  j = j || '"events":['
  do i = 1 to evn
    if i > 1 then j = j || ','
    j = j || '"' || json_esc(ev.i) || '"'
  end
  j = j || ']}'
  call serve_json cs, 200, j
  return

ev_add: procedure expose ev. evn
  parse arg ts, text
  if datatype(evn,'W') = 0 then evn = 0
  if evn < 50 then evn = evn + 1
  i = evn
  do while i > 1
    j = i - 1
    ev.i = ev.j
    i = j
  end
  ev.1 = ts text
  return

api_perf: procedure expose cfg. sess.
  parse arg cs, tok
  if \cfg.noauth & \sess_ok(tok) then do
    call serve_json cs, 401, '{"ok":false,"error":"not logged in"}'
    return
  end
  json = perf_collect()
  call serve_json cs, 200, json
  return

perf_collect: procedure expose cfg.
  avg = 0; nproc = 0; paging = 0; mdc = 0
  mdcr = 0; mdcw = 0
  q0=0; q1=0; q2=0; q3=0; dorm=0
  e1=0; e2=0; e3=0; lim=0
  users=0; dialed=0; net=0
  disp=0; elig=0
  spool_pct=0; page_pct=0
  proc.0 = 0
  vol.0 = 0
  parse value run_cmd('CP INDICATE LOAD') with rc '|' out
  call perf_parse_load out
  parse value run_cmd('CP INDICATE ACTIVE') with rc '|' aout
  call perf_parse_active aout
  parse value run_cmd('CP QUERY USERS') with rc '|' uout
  call perf_parse_users uout
  parse value run_cmd('CP QUERY ALLOC') with rc '|' a2
  call perf_parse_alloc a2
  j = '{"ok":true,'
  j = j || '"avgproc":'avg','
  j = j || '"nproc":'nproc','
  j = j || '"paging":'paging','
  j = j || '"mdchit":'mdc','
  j = j || '"mdcr":'mdcr',"mdcw":'mdcw','
  j = j || '"q0":'q0',"q1":'q1',"q2":'q2',"q3":'q3','
  j = j || '"e1":'e1',"e2":'e2',"e3":'e3','
  j = j || '"dormant":'dorm',"limited":'lim','
  j = j || '"users":'users',"dialed":'dialed',"net":'net','
  j = j || '"disp":'disp',"elig":'elig','
  j = j || '"spoolpct":'spool_pct',"pagepct":'page_pct','
  j = j || '"procs":['
  do i = 1 to proc.0
    if i > 1 then j = j || ','
    j = j || '{"id":"'proc.i.id'","pct":'proc.i.pc'}'
  end
  j = j || '],"vols":['
  do i = 1 to vol.0
    if i > 1 then j = j || ','
    j = j || '{"vol":"'vol.i.vol'","type":"'vol.i.type'",'
    j = j || '"used":'vol.i.used',"total":'vol.i.total','
    j = j || '"pct":'vol.i.pc'}'
  end
  j = j || ']}'
  return j

perf_parse_load: procedure expose avg nproc paging mdc mdcr mdcw,
  q0 q1 q2 q3 dorm e1 e2 e3 lim proc.
  parse arg out
  proc.0 = 0
  do while out \= ''
    parse var out line '0A'x out
    line = strip(line)
    u = translate(line)
    if pos('AVGPROC-', u) > 0 then do
      parse var u . 'AVGPROC-' p '% ' np .
      if datatype(p,'W') then avg = p + 0
      if datatype(np,'W') then nproc = np + 0
    end
    if pos('PAGING-', u) > 0 then do
      parse var u . 'PAGING-' pg '/SEC' .
      if datatype(pg,'W') then paging = pg + 0
    end
    if pos('MDC READS-', u) > 0 then do
      parse var u . 'MDC READS-' mr '/SEC WRITES-' mw '/SEC' .
      if datatype(mr,'W') then mdcr = mr + 0
      if datatype(mw,'W') then mdcw = mw + 0
    end
    if pos('HIT RATIO-', u) > 0 then do
      parse var u . 'HIT RATIO-' hr '%' .
      if datatype(hr,'W') then mdc = hr + 0
    end
    if abbrev(u,'Q0-') then do
      parse var u 'Q0-' v '(' .
      if datatype(v,'W') then q0 = v + 0
      if pos('DORMANT-', u) > 0 then do
        parse var u . 'DORMANT-' d .
        if datatype(d,'W') then dorm = d + 0
      end
    end
    if abbrev(u,'Q1-') then call perf_q u, 'Q1', 'q1'
    if abbrev(u,'Q2-') then call perf_q u, 'Q2', 'q2'
    if abbrev(u,'Q3-') then call perf_q u, 'Q3', 'q3'
    if pos('E1-', u) > 0 then call perf_q u, 'E1', 'e1'
    if pos('E2-', u) > 0 then call perf_q u, 'E2', 'e2'
    if pos('E3-', u) > 0 then call perf_q u, 'E3', 'e3'
    if pos('LIMITED-', u) > 0 then do
      parse var u . 'LIMITED-' lv .
      if datatype(lv,'W') then lim = lv + 0
    end
    if pos('PROC ', u) > 0 then call perf_parse_procs u
  end
  return

perf_q: procedure expose q1 q2 q3 e1 e2 e3
  parse arg u, key, var
  parse var u . (key) '-' v '(' .
  if \datatype(v,'W') then return
  call value var, v + 0
  return

perf_parse_procs: procedure expose proc.
  parse arg u
  rest = u
  do while pos('PROC ', rest) > 0
    parse var rest . 'PROC ' pid '-' pct '%' rest
    pid = strip(pid)
    if datatype(pct,'W') then do
      n = proc.0 + 1
      proc.0 = n
      proc.n.id = pid
      proc.n.pc = pct + 0
    end
  end
  return

perf_parse_active: procedure expose users disp elig dorm
  parse arg out
  do while out \= ''
    parse var out line '0A'x out
    u = translate(strip(line))
    if pos('USERS,', u) > 0 & pos('DISP,', u) > 0 then do
      parse var u us 'USERS,' ds 'DISP,' el 'ELIG,' dm 'DORM' .
      if datatype(strip(us),'W') then users = strip(us) + 0
      if datatype(strip(ds),'W') then disp = strip(ds) + 0
      if datatype(strip(el),'W') then elig = strip(el) + 0
      if datatype(strip(dm),'W') then dorm = strip(dm) + 0
    end
  end
  return

perf_parse_users: procedure expose users dialed net
  parse arg out
  do while out \= ''
    parse var out line '0A'x out
    u = translate(strip(line))
    if pos('USERS,', u) = 0 then iterate
    if pos('DIALED,', u) = 0 then iterate
    parse var u us 'USERS,' . di 'DIALED,' . ne 'NET' .
    if datatype(strip(us),'W') then users = strip(us) + 0
    if datatype(strip(di),'W') then dialed = strip(di) + 0
    if datatype(strip(ne),'W') then net = strip(ne) + 0
  end
  return

perf_parse_alloc: procedure expose vol. spool_pct page_pct
  parse arg out
  vol.0 = 0
  st = 0; su = 0; pt = 0; pu = 0
  cur = ''
  do while out \= ''
    parse var out line '0A'x out
    u = translate(strip(line))
    if abbrev(u, 'DASD ') then do
      parse var u 'DASD' . vname .
      cur = strip(vname)
      iterate
    end
    if cur = '' then iterate
    if abbrev(u, 'SPOOL') | abbrev(u, 'PAGE') | abbrev(u, 'DRCT') then do
      parse var u typ 'TOTAL=' t 'INUSE=' iu 'AVAIL=' .
      typ = strip(typ)
      if \datatype(t,'W') | \datatype(iu,'W') then iterate
      t = t + 0; iu = iu + 0
      if typ = 'SPOOL' then do; st = st + t; su = su + iu; end
      if typ = 'PAGE' then do; pt = pt + t; pu = pu + iu; end
      if t = 0 then iterate
      pct = format(iu * 100 / t,,0)
      n = vol.0 + 1
      vol.0 = n
      vol.n.vol = cur
      vol.n.type = typ
      vol.n.used = iu
      vol.n.total = t
      vol.n.pc = pct + 0
    end
  end
  if st > 0 then spool_pct = format(su * 100 / st,,0) + 0
  else spool_pct = 0
  if pt > 0 then page_pct = format(pu * 100 / pt,,0) + 0
  else page_pct = 0
  return
