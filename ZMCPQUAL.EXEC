/* REXX: fixed disposable ZTQUAL build/test. No arbitrary commands. */
numeric digits 20
parse upper arg token action extra
if length(token) <> 16 then exit 12
if verify(token,'0123456789ABCDEF') <> 0 then exit 12
if extra <> '' then exit 12
select
 when action='BUILD' then cmd='CMSCLNK ZTQUAL PLAIN'
 when action='TEST' then cmd='ZTQUAL'
 when action='FILEDEFS' then cmd='FILEDEF'
 otherwise exit 12
end
seq=0
out.0=0
'PIPE CMS' cmd '| TAKE 4097 | STEM out.'
cmdrc=rc
if out.0>4096 then do
 call emit 'F','LIMIT'
 exit 12
end
total=0
a=1
b=0
do i=1 to out.0
 if length(out.i)>4096 then do
  call emit 'F','LIMIT'
  exit 12
 end
 total=total+length(out.i)
 if total>1048576 then do
  call emit 'F','LIMIT'
  exit 12
 end
 do j=1 to length(out.i)
  a=(a+c2d(substr(out.i,j,1)))//65521
  b=(b+a)//65521
 end
end
sum=b*65536+a
call emit 'B',cmdrc out.0 total sum
do i=1 to out.0
 call emit 'R',i length(out.i)
 do j=1 to length(out.i) by 24
  call emit 'D',c2x(substr(out.i,j,min(24,length(out.i)-j+1)))
 end
end
call emit 'Z','DONE'
exit 0
emit: procedure expose token seq
 parse arg kind,body
 say 'ZM1' token kind seq body
 parse pull ack
 if strip(ack) <> 'ZA1' token seq then do
  say 'ZM1' token 'F' seq 'ACK'
  exit 12
 end
 seq=seq+1
 return
